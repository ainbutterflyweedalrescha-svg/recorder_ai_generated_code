{
  "name": "registerflow",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "api",
    "web"
  ],
"scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm --workspace api run dev\" \"npm --workspace web run dev\"",
    "db:migrate": "tsx --env-file=.env db/migrate.ts",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "test": "vitest run",
    "lint": "eslint \"api/src/**/*.ts\" \"web/src/**/*.{ts,tsx}\" \"db/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
